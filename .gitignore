# OS files
.DS_Store
Thumbs.db
desktop.ini
*.tmp

# Editor & IDE directories
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Backend Dependencies & Cache
parkir-member/backend/vendor/
parkir-member/backend/.env
parkir-member/backend/.env.backup
parkir-member/backend/.env.production
parkir-member/backend/.phpunit.result.cache
parkir-member/backend/.phpunit.cache
parkir-member/backend/storage/*.key
parkir-member/backend/storage/logs/*.log
parkir-member/backend/storage/framework/cache/data/*
